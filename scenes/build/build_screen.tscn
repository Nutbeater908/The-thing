[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/build/build_screen.gd" id="1_screen"]
[ext_resource type="Script" path="res://scripts/build/assembly_grid.gd" id="2_grid"]

[sub_resource type="SystemFont" id="SystemFont_cjk"]
font_names = PackedStringArray("Microsoft YaHei", "SimHei", "Noto Sans CJK SC", "sans-serif")

[sub_resource type="StyleBoxFlat" id="SBF_panel"]
content_margin_left = 14.0
content_margin_top = 14.0
content_margin_right = 14.0
content_margin_bottom = 14.0
